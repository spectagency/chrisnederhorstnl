---
// Inhoudsopgave voor artikelen en voor de secties van de homepage. Vult de linkerkolom (dezelfde plek als het oude
// navigatiemenu) met de H2-koppen van het artikel. Wordt alleen gerenderd als er
// genoeg koppen zijn — die afweging maakt ArticleLayout. Op mobiel valt deze weg
// (zie global.css) en neemt <MobileToc> het over.
export interface TocHeading {
  slug: string;
  text: string;
}
interface Props {
  headings: TocHeading[];
}
const { headings } = Astro.props;
---
<aside class="side toc" id="toc" aria-label="Op deze pagina">
  {/* Optioneel blok boven de lijst; de homepage zet hier het portret, zoals
      bovenin de zijbalk van de oude chrisnederhorst.nl. */}
  <slot name="intro" />
  <div class="group">
    <h4>Op deze pagina</h4>
    <nav>
      {headings.map((h) => (
        <a href={`#${h.slug}`} data-toc={h.slug}>
          <span class="lead"></span>{h.text}
        </a>
      ))}
    </nav>
  </div>
  <div class="help">
    <h5>Contact</h5>
    <p>Een vraag of een reactie? Neem gerust contact op.</p>
    <a href="/#contact" class="cta">Naar contact →</a>
  </div>
</aside>

<script>
  // Scrollspy: markeer de kop van de sectie die in beeld is.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]'));
  const byId = new Map(links.map((a) => [a.dataset.toc, a]));
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            byId.get(e.target.id)?.classList.add('active');
          }
        }
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>
