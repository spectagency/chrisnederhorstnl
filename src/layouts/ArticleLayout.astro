---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import RelatedArticles from '../components/content/RelatedArticles.astro';
import Byline from '../components/content/Byline.astro';
import Avatar from '../components/content/Avatar.astro';
import Toc from '../components/layout/Toc.astro';
import MobileToc from '../components/layout/MobileToc.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../data/site';
import { findNavLocation } from '../data/navigation';
import {
  ID,
  abs,
  articleId,
  authorNode,
  imageNode,
  isoDuration,
  pageId,
  ref,
  type LdNode,
} from '../lib/schema';
import type { Crumb } from '../components/layout/Breadcrumbs.astro';
import type { ImageMetadata, MarkdownHeading } from 'astro';

interface Props {
  title: string;
  /** Kortere titel voor de <title>-tag; de <h1> blijft `title`. */
  shortTitle?: string;
  description: string;
  lead?: string;
  publishDate: Date;
  updatedDate?: Date;
  readingTime?: string;
  readingMinutes?: number;
  wordCount?: number;
  image?: ImageMetadata;
  slug: string;
  related?: string[];
  headings?: MarkdownHeading[];
  /** Uit op pagina's die van voor naar achter gelezen worden; zie de frontmatter. */
  toc?: boolean;
}
const {
  title,
  shortTitle,
  description,
  lead,
  publishDate,
  updatedDate,
  readingTime,
  readingMinutes,
  wordCount,
  image,
  slug,
  related = [],
  headings = [],
  toc = true,
} = Astro.props;

// Inhoudsopgave uit de H2-koppen. Onder de twee koppen loont een aparte kolom niet;
// dan valt de linkerkolom weg en leest het artikel als gecentreerde kolom.
// `toc: false` in de frontmatter doet hetzelfde voor een pagina die je van voor
// naar achter leest: springen naar een kop heeft daar geen nut, en zonder
// linkerkolom krijgt de pagina de smalle, gecentreerde leeskolom.
const tocHeadings = headings.filter((h) => h.depth === 2);
const hasToc = toc && tocHeadings.length >= 2;

const path = `/${slug}`;
const loc = await findNavLocation(path);

// Twee kruimels, geen drie. De navigatiegroep ('Over mij', 'Kennis', …) stond
// hier eerder als middelste kruimel, maar er bestaat geen groepspagina om naar te
// linken. Google eist `item` op elke kruimel behalve de laatste, dus die
// link-loze middelste kruimel leverde op elk artikel de fout
// "Missing field 'item' (in 'itemListElement')" op. De groep zelf verdwijnt
// daarmee niet uit het schema: hij staat als `articleSection` op de Article-node
// hieronder, wat de plek is waar een rubriek hoort.
//
// Dit is ook eerlijker dan een gelinkte tussenkruimel: de URL-structuur is plat
// (/pagina, niet /groep/pagina), dus er ís geen
// tussenniveau om naartoe te kruimelen.
const crumbs: Crumb[] = [
  { label: 'Home', href: '/' },
  { label: title },
];

const fmtMonth = (d: Date) => new Intl.DateTimeFormat('nl-NL', { month: 'short', year: 'numeric' }).format(d);
const modified = updatedDate ?? publishDate;

// De Article-node verwijst met `@id` naar de auteur, uitgever en site die
// BaseLayout al in de graph zet — geen tweede, losse kopie van dezelfde entiteit.
// `articleSection` hergebruikt de navigatiegroep die hierboven al voor het
// kruimelpad is opgezocht.
const articleLd: LdNode = {
  '@type': 'Article',
  '@id': articleId(path),
  headline: title,
  name: title,
  description,
  abstract: lead ?? description,
  inLanguage: SITE.lang,
  datePublished: publishDate.toISOString(),
  dateModified: modified.toISOString(),
  author: ref(ID.author),
  publisher: ref(ID.author),
  isPartOf: ref(ID.website),
  mainEntityOfPage: ref(pageId(path)),
  url: abs(path),
  ...(image ? { image: imageNode(image, title) } : {}),
  ...(loc ? { articleSection: loc.group.title } : {}),
  ...(wordCount ? { wordCount } : {}),
  ...(readingMinutes ? { timeRequired: isoDuration(readingMinutes) } : {}),
};

// De auteurspagina is een gewoon artikel, maar beschrijft de Person-entiteit
// waar élk ander artikel met `@id` naar verwijst. Die pagina moet
// dus een ProfilePage zijn, anders wijst `Person.url` naar iets dat zichzelf
// alleen als Article presenteert en is de E-E-A-T-keten niet sluitend.
// De check hangt aan SITE.author.path, zodat een verhuizing van de pagina hier
// vanzelf meeloopt in plaats van een hardgecodeerde slug te breken.
const isAuthorPage = path === SITE.author.path;

// `mainEntity` krijgt de uitgeschreven Person-node, geen `@id`-verwijzing. Google
// leest ProfilePage als apart resultaattype en eist daar een echte Person of
// Organization mét `name`; een kale verwijzing kon het niet thuisbrengen en gaf
// op de auteurspagina van koudschuim.info de fout "Invalid object type for field '<parent_node>'". Het
// `@id` blijft erin staan, dus het is dezelfde entiteit als de Person die
// BaseLayout al in de graph zet — niet een tweede, naamloze kopie.
//
// `dateCreated`/`dateModified` zijn de velden die Google bij een ProfilePage
// verwacht; `datePublished` blijft daarnaast staan voor de Article-node.
const pageLd: LdNode = {
  datePublished: publishDate.toISOString(),
  dateModified: modified.toISOString(),
  ...(isAuthorPage
    ? {
        '@type': 'ProfilePage',
        dateCreated: publishDate.toISOString(),
        mainEntity: authorNode,
      }
    : {}),
};
---
<BaseLayout
  title={shortTitle ?? title}
  description={description}
  ogType="article"
  layout={hasToc ? 'aside' : 'full'}
  image={image}
  breadcrumbs={crumbs}
  page={pageLd}
  schema={[articleLd]}
>
  <Fragment slot="head">
    <meta property="article:author" content={SITE.author.name} />
    <meta property="article:published_time" content={publishDate.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    {loc && <meta property="article:section" content={loc.group.title} />}
  </Fragment>

  {hasToc && <Toc slot="aside" headings={tocHeadings} />}

  <Fragment slot="hero">
    <div class="shell"><div class="pagehead">
      <Breadcrumbs items={crumbs} />
      <h1>{title}</h1>
      <p class="lead">{lead ?? description}</p>
      <div class="meta">
        <span class="who"><Avatar size={30} />{SITE.author.name}</span>
        {readingTime && <span>· {readingTime}</span>}
        <span>· Bijgewerkt {fmtMonth(modified)}</span>
      </div>
    </div></div>
  </Fragment>

  <div class="content single">
    <div class="main">
      <div class="prose">
        <slot />
      </div>
      <Byline />
    </div>

    <RelatedArticles currentSlug={slug} related={related} />

    {/* TODO: definitieve afsluittekst. */}
    <div class="endcta">
      <div>
        <h3>Vragen of een reactie?</h3>
        <p>Neem gerust contact op.</p>
      </div>
      <Button href="/contact" variant="ghost">Naar contact</Button>
    </div>
  </div>

  {hasToc && (
    <MobileToc
      title="Op deze pagina"
      label="Inhoudsopgave"
      items={tocHeadings.map((h) => ({ id: h.slug, label: h.text }))}
    />
  )}
</BaseLayout>
