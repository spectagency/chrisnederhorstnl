---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';
import Header from '../components/layout/Header.astro';
import MobileNav from '../components/layout/MobileNav.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '../components/layout/Analytics.astro';
import {
  SITE_NODES,
  breadcrumbNode,
  breadcrumbId,
  graph,
  imageNode,
  pageId,
  ref,
  ID,
  abs,
  type BreadcrumbItem,
  type LdNode,
} from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /**
   * Kolomindeling van de body:
   *  - 'full'  → gecentreerde leeskolom (zelfde breedte als voorheen, zonder linkerkolom). Standaard.
   *  - 'aside' → tweekolomsraster met een `aside`-slot links (bv. de inhoudsopgave op artikelen).
   *  - 'bare'  → geen wrapper; de pagina regelt haar eigen containers (bv. de 404).
   */
  layout?: 'full' | 'aside' | 'bare';
  ogType?: 'website' | 'article';
  /** Deelbeeld voor og:image én `primaryImageOfPage`. */
  image?: ImageMetadata;
  /**
   * Kruimelpad van deze pagina. Dezelfde lijst gaat naar de <Breadcrumbs />-
   * component; hier wordt hij de BreadcrumbList in de graph.
   */
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Extra velden op de WebPage-node van deze pagina. Wordt als laatste gespreid,
   * dus een pagina kan hiermee ook het `@type` overschrijven — de contactpagina is
   * een `ContactPage`, de sitemap een `CollectionPage`, enzovoort. Die subtypes
   * zíjn WebPages, dus dat blijft één node in plaats van twee die hetzelfde
   * beschrijven.
   */
  page?: LdNode;
  /** Losse extra nodes in de graph (bv. de Article-node van een artikel). */
  schema?: LdNode[];
  /**
   * Houd deze pagina uit de zoekresultaten. Alleen voor pagina's die geen eigen
   * zoekresultaat verdienen — de 404 is er zo één: die bestaat op elke niet-
   * bestaande URL en zou anders als duizend dunne pagina's kunnen worden gezien.
   */
  noindex?: boolean;
}
const {
  title,
  description,
  layout = 'full',
  ogType = 'website',
  image,
  breadcrumbs,
  page = {},
  schema = [],
  noindex = false,
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title}${SITE.titleSuffix}`;
const path = Astro.url.pathname;
// Via `abs()`, zodat de canonical exact dezelfde vorm heeft als de `@id`'s in de
// JSON-LD en de URL's in de sitemap: absoluut, zonder sluitende slash.
const canonical = abs(path);

const webPage: LdNode = {
  '@type': 'WebPage',
  '@id': pageId(path),
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: SITE.lang,
  isPartOf: ref(ID.website),
  about: ref(ID.author),
  ...(breadcrumbs?.length ? { breadcrumb: ref(breadcrumbId(path)) } : {}),
  // Alleen een échte pagina-afbeelding is de `primaryImageOfPage`. Het site-brede
  // deelbeeld hieronder valt daar bewust buiten: dat is een merkbeeld voor de
  // sociale kaart, niet de hoofdafbeelding van deze specifieke pagina.
  ...(image ? { primaryImageOfPage: imageNode(image, title) } : {}),
  ...page,
};

// Deelbeeld voor sociale media. Zonder `og:image` toont WhatsApp, LinkedIn of
// Facebook een kale tekstregel in plaats van een kaart met beeld. Elke pagina
// hoort er dus een te hebben, ook de pagina's zonder eigen afbeelding — vandaar
// de terugval op het merkbeeld.
//
// Dat merkbeeld staat bewust in `public/` en niet in de beeldpipeline. Twee
// redenen: het is al op de 1200×630 die de platforms willen (bijgesneden uit het
// herobeeld met `sharp`, zie project-docs/HERGEBRUIK.md), en de URL blijft
// gelijk tussen builds. Een gehashte `/_astro/`-naam verandert zodra het bestand
// verandert, en dan staat er bij elk eerder gedeeld bericht een dood beeld.
const shareImage = image
  ? { url: abs(image.src), width: image.width, height: image.height }
  : { url: abs('/og-default.jpg'), width: 1200, height: 630 };

const ld = graph([
  ...SITE_NODES,
  webPage,
  breadcrumbs?.length ? breadcrumbNode(path, breadcrumbs) : null,
  ...schema,
]);
---
<!DOCTYPE html>
<html lang={SITE.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:image" content={shareImage.url} />
  <meta property="og:image:width" content={String(shareImage.width)} />
  <meta property="og:image:height" content={String(shareImage.height)} />
  <meta property="og:image:alt" content={title} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage.url} />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline />

  <Analytics />

  <slot name="head" />
</head>
<body class={`lay-${layout}`}>
  <Header />
  <MobileNav />
  <slot name="hero" />

  {layout === 'aside' ? (
    <div class="shell"><div class="wrap">
      <slot name="aside" />
      <slot />
    </div></div>
  ) : layout === 'bare' ? (
    <slot />
  ) : (
    <div class="shell"><div class="onecol">
      <slot />
    </div></div>
  )}

  <Footer />

  <div class="nav-overlay"></div>
  <script>
    function ready(fn: () => void) {
      if (document.readyState !== 'loading') fn();
      else document.addEventListener('DOMContentLoaded', fn);
    }
    ready(() => {
      const btn = document.querySelector('.menu-btn');
      const ov = document.querySelector('.nav-overlay');
      const close = () => {
        document.body.classList.remove('nav-open');
        btn?.setAttribute('aria-expanded', 'false');
      };
      const toggle = () => {
        const open = document.body.classList.toggle('nav-open');
        btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      btn?.addEventListener('click', toggle);
      ov?.addEventListener('click', close);
      document.querySelectorAll('.mnav a').forEach((a) => a.addEventListener('click', close));
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    });
  </script>
</body>
</html>
